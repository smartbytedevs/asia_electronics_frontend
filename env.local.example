# =============================================================================
# Asia Electronics — FRONTEND local development environment TEMPLATE
# =============================================================================
# This is a template, not a live environment file. Next.js does not load it.
#
# To use it:  copy this file to `.env.local` in the same directory, then fill
#             in the two placeholders marked `TODO`.
#
#   PowerShell:  Copy-Item env.local.example .env.local
#   bash:        cp env.local.example .env.local
#
# `.env.local` is git-ignored and must never be committed.
#
# LOCAL DEVELOPMENT ONLY. Production values (real domains, real secrets) are
# supplied through the hosting platform's environment variables, never here.
#
# Both apps in this workspace must agree on the auth values:
#   frontend BETTER_AUTH_URL                 = http://localhost:3000
#   backend  BETTER_AUTH_ISSUER              = http://localhost:3000
#   backend  BETTER_AUTH_AUDIENCE            = http://localhost:3000
#   backend  BETTER_AUTH_JWKS_URL            = http://localhost:3000/api/auth/jwks
# =============================================================================

# --- Backend REST API ---------------------------------------------------------
# Base URL of the Asia Electronics backend API (separate repository).
# Local backend runs on port 8080. Must NOT point at a hosted API.
NEXT_PUBLIC_API_URL=http://localhost:8080/api/v1

# --- Public site URL (SEO / metadata) -----------------------------------------
# Used by src/lib/seo.js and src/app/layout.js for metadataBase + canonical
# URLs. Client-visible.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- Better Auth --------------------------------------------------------------
# TODO(developer): replace this placeholder with your OWN random local secret.
# It signs sessions and encrypts the JWT private key at rest (server-side only).
# Generate one locally, e.g.:  openssl rand -base64 32
# Do not reuse any production secret and never commit the real value.
BETTER_AUTH_SECRET=REPLACE_WITH_LOCAL_DEV_SECRET

# Public base URL of this frontend. Server and browser must agree so Better Auth
# cookies are stored for the correct origin. Also the JWT issuer + audience.
BETTER_AUTH_URL=http://localhost:3000

# Base path where the Better Auth route handler is mounted in this app.
# JWKS endpoint = {BETTER_AUTH_URL}{BETTER_AUTH_BASE_PATH}/jwks
#              = http://localhost:3000/api/auth/jwks
BETTER_AUTH_BASE_PATH=/api/auth

# Additional browser origins trusted for cookies / CSRF checks (comma
# separated). The canonical origin (BETTER_AUTH_URL) is always trusted.
BETTER_AUTH_TRUSTED_ORIGINS=http://localhost:3000

# --- Better Auth: browser client ---------------------------------------------
# Origin the BROWSER uses to call Better Auth. Non-NEXT_PUBLIC_ variables are
# not available in the browser bundle, so this public variable is what keeps
# the client on this app's origin. Must equal BETTER_AUTH_URL.
# If unset, the browser client uses the current page origin instead.
NEXT_PUBLIC_BETTER_AUTH_URL=http://localhost:3000

# Optional. Must match BETTER_AUTH_BASE_PATH. Defaults to /api/auth when unset.
NEXT_PUBLIC_BETTER_AUTH_BASE_PATH=/api/auth

# Better Auth JWT plugin. The backend verifier only accepts RS256 by default,
# and expires tokens after 15 minutes.
BETTER_AUTH_JWT_ALGORITHM=RS256
BETTER_AUTH_JWT_EXPIRATION_TIME=15m

# --- MongoDB (Better Auth persistence — server-side only) ----------------------
# TODO(developer): provide a connection string for a DEDICATED local/development
# database that stores Better Auth data only (user, session, account,
# verification, jwks collections).
#
# Requirements:
#   - the database name is taken from the URI path, so choose a name that is
#     clearly separate from the backend application database
#     (e.g. a `..._auth` database vs the backend's own database)
#   - server-side only; never exposed to the browser and never committed
#   - leave this empty if you have not created the database yet — the app throws
#     a clear "MONGODB_URI is not configured" error until it is set
#
# What NOT to do: do not point this at a production database and do not reuse
# the backend's URI if it shares the same database name.
MONGODB_URI=
