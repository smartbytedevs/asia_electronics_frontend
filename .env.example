# =============================================================================
# Asia Electronics — frontend environment template
# =============================================================================
# Copy this file to `.env.local` in the repository root and fill in the
# placeholders marked TODO. `.env.local` is git-ignored and must never be
# committed.
#
# Next.js loads, in order: .env.$(NODE_ENV).local, .env.local, .env.$(NODE_ENV),
# .env (all from the project root, not from src/).
#
# Production values belong in the hosting platform's environment variables.
# =============================================================================

# --- Backend REST API ---------------------------------------------------------
# Local Asia Electronics backend (separate repository). The frontend calls this
# from the server (SSR + API proxy); it must never point at another store's
# hosted API.
# Production example: https://api.your-domain.example/api/v1
NEXT_PUBLIC_API_URL=http://localhost:8080/api/v1

# --- Site URL (SEO / canonical URLs) ------------------------------------------
# Used by src/lib/seo.js and src/app/layout.js for metadataBase, canonical links
# and JSON-LD. Required in production: a missing value fails loudly rather than
# publishing another domain's canonical URLs.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- Better Auth: server ------------------------------------------------------
# Secret used to sign sessions and encrypt the JWT private key at rest.
# Server-side only.
# TODO: generate your own local secret, e.g.  openssl rand -base64 32
# Never commit the real value and never reuse a production secret.
BETTER_AUTH_SECRET=

# Canonical origin of this frontend (server side). Must match
# NEXT_PUBLIC_BETTER_AUTH_URL below, the JWT issuer/audience, and the backend
# BETTER_AUTH_ISSUER / BETTER_AUTH_AUDIENCE / BETTER_AUTH_JWKS_URL settings.
BETTER_AUTH_URL=http://localhost:3000

# Base path of the Better Auth route handler in this app.
BETTER_AUTH_BASE_PATH=/api/auth

# Additional browser origins Better Auth treats as trusted for cookies / CSRF
# checks (comma-separated). The canonical origin is always trusted
# automatically; list extra origins only (e.g. an apex domain that redirects).
BETTER_AUTH_TRUSTED_ORIGINS=http://localhost:3000

# --- Better Auth: browser client ---------------------------------------------
# Origin the BROWSER uses to call Better Auth. Non-NEXT_PUBLIC_ variables are
# not available in the browser bundle, so this public variable is what keeps
# the client on this app's origin. Must equal BETTER_AUTH_URL.
# If unset, the browser client uses the origin currently serving the page
# (window.location.origin) and never a hardcoded production domain.
NEXT_PUBLIC_BETTER_AUTH_URL=http://localhost:3000

# Optional. Must match BETTER_AUTH_BASE_PATH. Defaults to /api/auth when unset.
NEXT_PUBLIC_BETTER_AUTH_BASE_PATH=/api/auth

# --- JWT (Better Auth jwt plugin) ---------------------------------------------
# RS256 is required by the backend verifier. Issuer and audience are derived
# from BETTER_AUTH_URL.
BETTER_AUTH_JWT_ALGORITHM=RS256
BETTER_AUTH_JWT_EXPIRATION_TIME=15m

# --- MongoDB (Better Auth persistence, server-side only) ----------------------
# Required. Dedicated database for Better Auth records (user, session, account,
# verification, jwks). The database name is taken from the URI path.
# Use a database that is SEPARATE from the backend application database.
# TODO: fill in your local/development connection string. Never commit it.
MONGODB_URI=
